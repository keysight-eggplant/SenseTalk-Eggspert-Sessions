
set clientList to ["Jackson", "Smith", "Jones", "Bradley", "Franklin", "Baker", "Kowalski"]

set numberProcessed to 0
repeat with each client in clientList
	put "Now Processing Client: " & client
	put -
	wait 30 ticks
	add 1 to numberProcessed
end repeat

answer "Initial Processing Complete. Press Return to Continue."

put "More processing"
wait 3
answer "Number Processed: " & numberProcessed title "All Done!"
